% เปรียบเทียบสัญญาณทั้ง 3 แบบ
clc;                % ล้างข้อความใน Command Window
clear;              % ลบตัวแปรเก่าทั้งหมด
close all;          % ปิดหน้าต่างกราฟทั้งหมด

dt = 0.001;         % กำหนดช่วงห่างของเวลา
t = 0:dt:1;         % สร้างเวลา 0 ถึง 1 วินาที

s = sin(2*pi*2*t);  % สร้างสัญญาณจริงความถี่ 2 Hz

noise = zeros(size(t)); % สร้าง Noise ที่มีค่าเริ่มต้นเป็น 0
noise(round(0.2/dt)+1) = 4;  % Spike ที่เวลา 0.2 วินาที
noise(round(0.5/dt)+1) = -4; % Spike ที่เวลา 0.5 วินาที
noise(round(0.8/dt)+1) = 4;  % Spike ที่เวลา 0.8 วินาที

x = s + noise;      % สร้างสัญญาณ Input ที่มี Noise

M = 71;             % กำหนดหน้าต่างกรอง 71 จุด
y = medfilt1(x, M); % กรอง Noise ด้วย Median Filter

figure(3);          % เปิดหน้าต่างกราฟที่ 3

plot(t, x, 'b', 'LineWidth', 1);
% สีน้ำเงิน คือสัญญาณ Input ที่มี Noise

hold on;             % วาดกราฟเส้นต่อไปในหน้าต่างเดิม

plot(t, y, 'r', 'LineWidth', 1.5);
% สีแดง คือสัญญาณหลังผ่าน Median Filter

plot(t, s, 'g--', 'LineWidth', 1);
% สีเขียวเส้นประ คือสัญญาณจริงที่ไม่มี Noise

legend('Noisy Signal', 'Median Filter Output', 'Original Signal');
% แสดงคำอธิบายของเส้นกราฟแต่ละสี

xlabel('Time (s)');  % ชื่อแกนนอน
ylabel('Amplitude'); % ชื่อแกนตั้ง
title('Median Filter Comparison'); % ชื่อกราฟ
grid on;             % แสดงเส้นตาราง
hold off;            % ยกเลิกการวาดกราฟซ้อน
