% สร้างสัญญาณ Input ที่มี Noise
clc;                % ล้างข้อความใน Command Window
clear;              % ลบตัวแปรเก่าทั้งหมด
close all;          % ปิดหน้าต่างกราฟทั้งหมด

dt = 0.001;         % กำหนดช่วงห่างของเวลา 0.001 วินาที
t = 0:dt:1;         % สร้างเวลาเริ่มจาก 0 ถึง 1 วินาที

s = sin(2*pi*2*t);  % สร้างสัญญาณจริงรูปคลื่นไซน์ ความถี่ 2 Hz

noise = zeros(size(t)); % สร้าง Noise โดยให้ทุกจุดเริ่มต้นเป็น 0

% สร้าง Spike Noise จำนวน 3 จุด
noise(round(0.2/dt)+1) = 4;  % Noise ค่า 4 ที่เวลา 0.2 วินาที
noise(round(0.5/dt)+1) = -4; % Noise ค่า -4 ที่เวลา 0.5 วินาที
noise(round(0.8/dt)+1) = 4;  % Noise ค่า 4 ที่เวลา 0.8 วินาที

x = s + noise;      % นำสัญญาณจริงบวกกับ Noise
% x คือสัญญาณ Input ที่มี Noise

figure(1);          % เปิดหน้าต่างกราฟที่ 1
plot(t, x, 'b');    % วาดกราฟ Input เป็นสีน้ำเงิน

xlabel('Time (s)'); % ชื่อแกนนอนคือเวลา
ylabel('Amplitude');% ชื่อแกนตั้งคือแอมพลิจูด
title('Input Signal with Noise'); % ชื่อกราฟ
grid on;            % แสดงเส้นตาราง
