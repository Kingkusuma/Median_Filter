% กรอง Noise ด้วย Median Filter
clc;                % ล้างข้อความใน Command Window
clear;              % ลบตัวแปรเก่าทั้งหมด
close all;          % ปิดหน้าต่างกราฟทั้งหมด

dt = 0.001;         % กำหนดช่วงห่างของเวลา
t = 0:dt:1;         % สร้างเวลา 0 ถึง 1 วินาที

s = sin(2*pi*2*t);  % สร้างสัญญาณจริงความถี่ 2 Hz

noise = zeros(size(t)); % สร้าง Noise โดยเริ่มต้นทุกจุดเป็น 0
noise(round(0.2/dt)+1) = 4;  % สร้าง Spike ที่เวลา 0.2 วินาที
noise(round(0.5/dt)+1) = -4; % สร้าง Spike ที่เวลา 0.5 วินาที
noise(round(0.8/dt)+1) = 4;  % สร้าง Spike ที่เวลา 0.8 วินาที

x = s + noise;      % รวมสัญญาณจริงกับ Noise

M = 71;             % กำหนดขนาดหน้าต่าง Median จำนวน 71 จุด

y = medfilt1(x, M);
% ใช้ Median Filter กรองสัญญาณ x
% medfilt1 คือคำสั่งกรองด้วยค่ามัธยฐาน
% M คือจำนวนจุดข้อมูลที่ใช้ในการหาค่ามัธยฐาน
% y คือสัญญาณหลังกรอง Noise

figure(2);          % เปิดหน้าต่างกราฟที่ 2
plot(t, y, 'r', 'LineWidth', 1.5);
% วาดสัญญาณหลังกรองเป็นสีแดง

xlabel('Time (s)'); % ชื่อแกนนอน
ylabel('Amplitude');% ชื่อแกนตั้ง
title('Median Filter Output'); % ชื่อกราฟ
grid on;            % แสดงเส้นตาราง
